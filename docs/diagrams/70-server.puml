@startuml 70-server
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 50
hide empty members
hide circle
title boussole-server — the HTTP API

class BoussoleServer <<@SpringBootApplication>> {
  +{static} start(ServerSettings) : RunningServer
}
class ServerSettings <<record>> {
  port : int
  subjects : Supplier<List<Path>>
  builtIn : List<BuiltInTrack>
  database : Path
  language : Optional<String>
  freeNavigation : boolean
}
class RunningServer <<record>>
class LearningConfiguration <<@Configuration>>

package "course" {
  class CourseController <<GET /api/subjects…>>
  class CreditViews <<authors, contributors, who wrote each session>>
  class CourseSummaryView <<record>>
  class CourseView <<record>>
  class ResumeView <<record>>
  class "CourseView.ScoreView" as ScoreView <<record: earned, missed, possible>>
  class "CourseView.PrerequisiteView" as PrerequisiteView <<record>>
}
package "session" {
  class SessionController <<…/sessions/{id}>>
  class SessionView <<record>>
  class "SessionView.PartView" as PartView <<record>>
}
package "exercise" {
  class ExerciseController <<…/exercises/{id}>>
  interface AttemptRequest <<sealed, JSON kind>>
  class AttemptView <<record>> {
    verdict, items, progress
    solution : SolutionView
  }
  class HintView <<record>>
  class SolutionView <<record>>
}
package "reward" {
  class StatsController <<GET /api/stats, /api/ranks, /api/achievements>>
  class "StatsController.StatsView" as StatsView <<record: points, ranks, records, route>>
}
package "files" {
  class SubjectFileController <<…/files/**, …/lang/{lang}/files/**>>
}
package "block" {
  class BlockViewMapper {
    +blocks(List<Block>) : List<BlockView>
  }
  interface BlockView <<sealed, JSON type>>
  interface InputView <<sealed, JSON kind>>
  class HintsView <<record>>
  class ProgressView <<record>>
  class SeededShuffle <<helpers>>
  class GraphPlacement <<helpers>> {
    +{static} place(GraphBlock) : Map<String, Point>
  }
}
package "guide" {
  class BundledTracks <<getting-started first>> {
    +{static} install(folder, language) : List<BuiltInTrack>
  }
  class BuiltInTrack <<record>> {
    id : String
    folder : Path
  }
}
package "reference" {
  class ReferenceController <<GET /api/references/preview>>
}
package "api" {
  class ServerController <<GET /api/server, POST stop>>
  class ApiExceptionHandler <<@RestControllerAdvice>>
}
package "web" {
  class LocalRequestFilter <<filter>>
  class InterfaceConfiguration <<serves web/>>
}

package "boussole-core" as core {
}

BoussoleServer ..> ServerSettings
ServerSettings *-- "*" BuiltInTrack : builtIn
BundledTracks ..> BuiltInTrack : installs
BoussoleServer ..> RunningServer
LearningConfiguration ..> core : adapters into use cases
CourseController --> core
SessionController --> core
ExerciseController --> core
SubjectFileController --> core
StatsController --> core
StatsController ..> StatsView
ReferenceController --> core : PreviewWebPage
CourseController ..> ResumeView : session to resume
CourseView *-- PrerequisiteView : a session waits for
CourseView *-- ScoreView : score
SessionController ..> SessionView
CourseView ..> CreditViews
SessionView ..> CreditViews : writtenBy
SessionView *-- PartView : parts
PartView ..> BlockViewMapper
ExerciseController ..> AttemptRequest : body
ExerciseController ..> AttemptView
AttemptView --> SolutionView : the correction
ExerciseController ..> HintView
ExerciseController ..> SolutionView
HintView ..> BlockViewMapper
SolutionView ..> BlockViewMapper
BlockViewMapper ..> BlockView : no answers
BlockView --> InputView : exercise input
BlockView --> HintsView : revealed only
BlockView --> ProgressView
BlockViewMapper ..> SeededShuffle : MCQ, order, match, choice gaps
BlockViewMapper ..> GraphPlacement : places the nodes

note bottom of LocalRequestFilter
  Host must be localhost; a change (POST)
  needs the X-Boussole header.
end note
@enduml
