@startuml 60-adapters
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 50
hide empty members
hide circle
title boussole-adapters — files, SQLite, configuration, YouTube

package "content" {
  class FileContentRepository {
    folders : Supplier<List<Path>>
  }
  class SubjectFolderCache {
    ~course() : Optional<Course>
  }
  class CourseFilesFingerprint <<helpers>> {
    ~{static} of(Path) : long
  }
}

package "progress" {
  class SqliteProgressRepository <<exercise_progress, attempt, session_finished>>
  class SqliteDeviceRepository <<device>>
  class SqliteDatabase {
    +{static} open(Path) : SqliteDatabase
    ~connect() : Connection
  }
}

package "config" {
  class BoussoleConfigFile {
    +read() : BoussoleConfig
    +addSubject(Path) : boolean
  }
  class BoussoleConfig <<record>> {
    language : Optional<String>
    port : int
    subjects : List<Path>
    freeNavigation : boolean
    tracksDir : Optional<Path>
    network : boolean
    networkPort : int
  }
  class BoussolePaths <<record>> {
    config, data, state : Path
    +configFile() / learnerProfile()
    +database() / serverLog()
  }
}

package "network" {
  class NetworkAddresses <<helpers>> {
    +{static} current() : private IPv4
    +{static} localName() : host.local
  }
  class LocalCertificate <<record>> {
    keystore, password, fingerprint
    +{static} ensure(folder, hosts)
    +shortFingerprint()
  }
}

package "video" {
  class YoutubeOEmbedCatalog
}

package "web" {
  class HttpWebPages <<never this machine or its network>> {
    +preview(URI) : PagePreview
  }
}

interface ContentRepository <<boussole-core port>>
interface ProgressRepository <<boussole-core port>>
interface DeviceRepository <<boussole-core port>>
interface VideoCatalog <<boussole-format>>
interface WebPages <<boussole-core port>>
class CourseLoader <<boussole-format>>

ContentRepository <|.. FileContentRepository
WebPages <|.. HttpWebPages
FileContentRepository *-- SubjectFolderCache : one per folder
SubjectFolderCache ..> CourseFilesFingerprint : changed?
SubjectFolderCache ..> CourseLoader : reads again
ProgressRepository <|.. SqliteProgressRepository
SqliteProgressRepository --> SqliteDatabase : database
DeviceRepository <|.. SqliteDeviceRepository
SqliteDeviceRepository --> SqliteDatabase : database
LocalCertificate ..> NetworkAddresses : names them all
VideoCatalog <|.. YoutubeOEmbedCatalog
BoussoleConfigFile ..> BoussoleConfig : reads
BoussoleConfigFile ..> BoussolePaths : forCurrentUser()

note bottom of SqliteDatabase
  Migrations in db/V*.sql, run once each,
  counted by PRAGMA user_version.
  Each attempt keeps its points and its stars (V4).
end note
@enduml
