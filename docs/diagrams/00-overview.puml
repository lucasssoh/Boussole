@startuml 00-overview
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 50
hide empty members
hide circle
title Boussole — modules and packages

package "boussole-cli" as cli {
  package "cli" as clipkg {
    class BoussoleCommand
    class ValidateCommand
  }
  package "cli.init" as initpkg {
    class InitCommand
  }
  package "cli.serve" as servepkg {
    class OpenCommand
    class ServeCommand
  }
}

package "boussole-server" as server {
  class BoussoleServer <<Spring Boot>>
  package "course, session, exercise, files" as controllers {
  }
  package "block" as views {
  }
}

package "boussole-adapters" as adapters {
  package "content" as content {
  }
  package "progress" as progress {
  }
  package "config" as config {
  }
  package "video" as video {
  }
}

package "boussole-core" as core {
  package "learn" as learn {
  }
  package "learn.check" as check {
  }
  package "learn.progress" as lprogress {
  }
}

package "boussole-format" as format {
  class SubjectInspector <<entry point>>
  package "load, parse, validate" as reading {
  }
  package "model" as model {
  }
}

package "web/ (Angular)" as web {
}

clipkg --> SubjectInspector : boussole validate
initpkg --> SubjectInspector : checks the new subject
servepkg --> BoussoleServer : starts
servepkg --> config : config.yaml
web ..> controllers : HTTP /api
BoussoleServer --> controllers
controllers --> learn : use cases
controllers --> views : answers left out
learn --> check : checks responses
learn --> lprogress : ProgressRepository (port)
learn --> model : reads
content ..|> learn : ContentRepository
progress ..|> lprogress : SqliteProgressRepository
content --> reading : CourseLoader
video ..|> reading : VideoCatalog
SubjectInspector --> reading
reading --> model : builds

note right of format
  format and core use no framework.
  Dependencies point down only
  (checked by ArchUnit).
end note
@enduml
