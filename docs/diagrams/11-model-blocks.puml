@startuml 11-model-blocks
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 50
hide empty members
hide circle
title boussole-format — the blocks of a session (package model.block)

interface Block <<sealed>> {
  +position() : SourcePosition
}
class ProseBlock <<record>> {
  markdown : String
}
interface InlineDirective <<sealed>>
class TermInlineDirective <<record>> {
  text : String
  id : Optional<String>
}
class LinkInlineDirective <<record>> {
  label, url : String
}
class PdfInlineDirective <<record>> {
  label : String
}
class ExampleBlock <<record>> {
  label : String
}
class RecallBlock <<record>>
class CalloutBlock <<record>>
enum CalloutKind {
  NOTE
  TIP
  WARNING
}
class VideoBlock <<record>> {
  label : String
  start, end : Optional<Duration>
}
interface VideoSource <<sealed>>
class YoutubeVideoSource <<record>> {
  youtubeId : String
}
class FileVideoSource <<record>> {
  +playable() : boolean
}
class PdfBlock <<record>> {
  label : String
}
class LinkBlock <<record>> {
  label, url : String
}
class GraphBlock <<record>> {
  label : String
  +placedByAuthor() : boolean
}
class GraphNode <<record>> {
  id : String
  label : Optional<String>
  at : Optional<GraphPoint>
  emphasized : boolean
}
class GraphEdge <<record>> {
  from, to : String
  directed : boolean
  label : Optional<String>
  emphasized : boolean
}
class GraphPoint <<record>> {
  x, y : int
}
enum GraphLayout {
  CIRCLE
  ROW
  LAYERS
}
class ExerciseBlock <<record>> {
  id : String
  minutes : OptionalInt
}
enum ExerciseType {
  NUMERIC
  TEXT
  FILL
  ORDER
  MATCH
  FREE
}
class McqBlock <<record>> {
  id : String
  multiple : boolean
  minutes : OptionalInt
}
class McqChoice <<record>> {
  text : String
  correct : boolean
  feedback : Optional<String>
}
class ExerciseHint <<record>>
class ExerciseSolution <<record>>
class ExerciseRefBlock <<record>> {
  id : String
}
class BlockWalker <<utility>> {
  +{static} walk(List<Block>) : Stream<Block>
}
class QuestionTimeEstimator <<utility>> {
  +{static} minutes(ExerciseBlock) : double
  +{static} minutes(McqBlock) : double
}
class SourceReference <<record>>
interface Answer <<sealed>>
note bottom of Answer : see 12-model-answers

Block <|.. ProseBlock
Block <|.. ExampleBlock
Block <|.. RecallBlock
Block <|.. CalloutBlock
Block <|.. VideoBlock
VideoBlock --> VideoSource : source
VideoSource <|.. YoutubeVideoSource
VideoSource <|.. FileVideoSource
FileVideoSource --> SourceReference : file
Block <|.. PdfBlock
Block <|.. GraphBlock
Block <|.. LinkBlock
GraphBlock *-- "1..*" GraphNode : nodes
GraphBlock *-- "*" GraphEdge : edges
GraphBlock --> GraphLayout : layout
GraphNode --> "0..1" GraphPoint : at
Block <|.. ExerciseBlock
Block <|.. McqBlock
Block <|.. ExerciseRefBlock

ProseBlock *-- "*" InlineDirective : inlines
InlineDirective <|.. TermInlineDirective
InlineDirective <|.. PdfInlineDirective
InlineDirective <|.. LinkInlineDirective
PdfInlineDirective --> SourceReference : source
PdfBlock --> SourceReference : source

ExampleBlock o-- "*" Block : content
RecallBlock o-- "*" Block : content
CalloutBlock o-- "*" Block : content
CalloutBlock --> CalloutKind : kind

ExerciseBlock --> ExerciseType : type
ExerciseBlock o-- "*" Block : statement
ExerciseBlock *-- "0..1" Answer : answer
ExerciseBlock *-- "*" ExerciseHint : hints
ExerciseBlock *-- "0..1" ExerciseSolution : solution
McqBlock o-- "*" Block : statement
McqBlock *-- "2..*" McqChoice : choices
McqBlock *-- "*" ExerciseHint : hints
McqBlock *-- "0..1" ExerciseSolution : solution
ExerciseHint o-- "*" Block : content
ExerciseSolution o-- "*" Block : content

BlockWalker ..> Block : walks nested
QuestionTimeEstimator ..> ExerciseBlock : estimates
QuestionTimeEstimator ..> McqBlock : estimates
@enduml
