@startuml 50-core-learn
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 50
hide empty members
hide circle
title boussole-core — studying a course (packages learn, learn.check, learn.progress, learn.reward) and the web pages it cites (reference)

package "learn" {
  interface ContentRepository <<port>> {
    +courses() : List<Course>
    +versions(subject) : List<Course>
  }
  class ListCourses <<use case>> {
    +list(language) : List<CourseOverview>
  }
  class OpenCourse <<use case>> {
    +open(subject, language) : CourseOverview
  }
  class OpenSession <<use case>> {
    +open(subject, session, language) : OpenedSession
  }
  class SubmitAttempt <<use case>> {
    +submit(ExerciseKey, LearnerResponse, session, language) : AttemptOutcome
  }
  class RevealNextHint <<use case>> {
    +reveal(ExerciseKey, language) : RevealedHint
  }
  class RevealSolution <<use case>> {
    +reveal(ExerciseKey, language) : RevealedSolution
  }
  class FinishSession <<use case>> {
    +finish(SessionKey, Duration)
  }
  class CourseLookup
  class CourseVersions <<helpers>> {
    +{static} pick(versions, language) : Course
    +{static} languages(versions) : List<String>
  }
  class CourseQuestions <<helpers>>
  class CourseOverview <<record>> {
    languages : List<String>
    finishedSessions : Set<String>
    lastStudied : Optional<Instant>
    waitingFor : Map<String, List<SessionId>>
    chapterLinks : Map<String, Set<String>>
    chapterWaitingFor : Map<String, List<String>>
    score : TrackScore
    resume : Optional<String>
  }
  class CourseOverviews
  class OpenedSession <<record>>
  class AttemptOutcome <<record>>
  class RevealedHint <<record>>
  class RevealedSolution <<record>>
  class ContentNotFoundException
  class LearningRuleException
}

package "learn.progress" {
  interface ProgressRepository <<port>> {
    +exercise(ExerciseKey) : ExerciseProgress
    +exercises(subject) : Map<String, ExerciseProgress>
    +saveExercise(ExerciseKey, ExerciseProgress, Instant)
    +saveSessionFinished(SessionKey, Instant, Duration)
    +finishedSessions(subject) : Set<String>
    +recordAttempt(ExerciseKey, session, Verdict, Instant)
    +lastActivity(subject) : Optional<LastActivity>
    +attemptHistory() : List<AttemptRecord>
    +sessionsFinished() : List<SessionFinishedRecord>
  }
  class LastActivity <<record>>
  class SessionProgress <<record>> {
    questions, answered, right : int
  }
  class ExerciseProgress <<record>> {
    attempts : int
    lastVerdict : Optional<Verdict>
    solved : boolean
    hintsRevealed : int
    +solutionUnlocked() : boolean
  }
  class ExerciseKey <<record>>
  class SessionKey <<record>>
}

package "learn.reward" {
  class ReadStudyStats <<use case>> {
    +read() : StudyStats
  }
  class PointRules <<helpers>> {
    +{static} weight(first, firstHere) : double
    +{static} flawlessBonus(sessionPoints) : double
    +AGAIN = 0.5
    +FLAWLESS = 0.10
  }
  class QuestionScore <<record>> {
    earned, possible : double
    +{static} of(question, response, CheckResult) : QuestionScore
    +{static} possible(question) : double
  }
  class ReadAchievements <<use case>> {
    +read() : List<AchievementProgress>
  }
  enum Achievement {
    COMPASS_IN_HAND
    DROP_BY_DROP
    TWENTY_TIMES_ON_THE_LOOM
    …
    +thresholds() : List<Integer>
    +levelOf(value) : int
  }
  class AchievementProgress <<record>> {
    value, level : int
  }
  class Records <<record>> {
    bestStreak, sessionsFinished, flawlessSessions : int
    firstTryRight, firstTryAnswered : int
  }
  class TrackScores <<helpers>> {
    +{static} of(Course, attempts) : TrackScore
    +{static} ofSession(Course, session, attempts) : TrackScore
  }
  class TrackScore <<record>> {
    earned, missed, possible : double
    +toPlay() : double
  }
  class GapSentences <<helpers>> {
    ~{static} of(statement) : Map<Integer, Integer>
  }
  class StudyStats <<record>> {
    points : double
    culture : Rank
    fields : List<FieldStanding>
    streakDays : int
    studiedToday : boolean
  }
  class FieldStanding <<record>> {
    domain : Domain
    points : double
    rank : Rank
  }
  enum Ladder {
    CULTURE
    SPECIALTY
  }
  class Rank <<record>> {
    tier, division, level : int
    intoLevel, levelSize, nextAt : double
    specialtiesMissing : int
    criticalThinkingMissing : boolean
    +{static} of(Ladder, points, Specialties) : Rank
  }
  class Specialties <<record>> {
    atLevel, besideCriticalThinking : int
    criticalThinking : boolean
    LEVEL = "specialist"
    FOR_SAGE = 3
  }
  class AttemptRecord <<record>>
  class SessionFinishedRecord <<record>>
  class RewardedSubjects <<record>> {
    excluded : Set<String>
    +rewards(subject) : boolean
  }
}

package "learn.check" {
  class QuestionChecker {
    +check(McqBlock, LearnerResponse) : CheckResult
    +check(ExerciseBlock, LearnerResponse) : CheckResult
  }
  interface "ResponseChecker<E, R>" as ResponseChecker {
    +responseType() : Class<R>
    +check(E, R) : CheckResult
    +checkResponse(E, LearnerResponse) : CheckResult
  }
  class McqResponseChecker
  class SingleAnswerResponseChecker
  class FillAnswerResponseChecker
  class OrderAnswerResponseChecker
  class MatchAnswerResponseChecker
  class SelfGradeResponseChecker
  class ExpectationMatcher <<helpers>> {
    +{static} matches(Expectation, String) : boolean
  }
  class ExpectationText <<helpers>>
  interface LearnerResponse <<sealed>>
  class ChoicesResponse <<record>>
  class ValueResponse <<record>>
  class GapsResponse <<record>>
  class OrderResponse <<record>>
  class MatchResponse <<record>>
  class SelfGradeResponse <<record>>
  class CheckResult <<record>> {
    verdict : Verdict
    items : List<CheckedItem>
  }
  class CheckedItem <<record>>
  enum Verdict {
    CORRECT
    PARTLY
    WRONG
  }
}

package "reference" {
  class PreviewWebPage <<use case>> {
    +preview(url) : PagePreview
  }
  interface WebPages <<port>> {
    +preview(URI) : PagePreview
  }
  class PagePreview <<record>> {
    reachable, embeddable : boolean
    title : Optional<String>
  }
}

ListCourses --> ContentRepository
ListCourses --> CourseOverviews
OpenCourse --> CourseOverviews
CourseOverviews ..> LastActivity : resume
CourseOverviews ..> SessionProgress : per session
ReadStudyStats --> ProgressRepository : history
ReadStudyStats ..> Rank : culture, specialty
Rank --> Ladder
Rank ..> Specialties : Sage, Grand Sage
ReadStudyStats --> ContentRepository : fields
QuestionScore ..> GapSentences : fill
ReadAchievements ..> AchievementProgress
AchievementProgress --> Achievement
ReadAchievements ..> ReadStudyStats : records
ReadAchievements ..> TrackScores : finished tracks, mock exams
ReadAchievements --> ProgressRepository : history
StudyStats --> Records
CourseOverviews ..> TrackScores : score
CourseOverviews ..> ChapterLinks : chapters in order
TrackScores ..> QuestionScore : possible
PreviewWebPage --> WebPages : pages
PreviewWebPage ..> PagePreview
ReadStudyStats --> RewardedSubjects : rewarded
SubmitAttempt --> RewardedSubjects : rewarded
FinishSession --> RewardedSubjects : rewarded
ReadStudyStats ..> StudyStats
StudyStats *-- FieldStanding
SubmitAttempt ..> QuestionScore : score
SubmitAttempt ..> PointRules : points
FinishSession ..> PointRules : flawless bonus
CourseOverviews --> ProgressRepository
OpenCourse --> CourseLookup
CourseLookup ..> CourseVersions : one track, one language
ListCourses ..> CourseVersions
OpenSession --> CourseLookup
SubmitAttempt --> CourseLookup
RevealNextHint --> CourseLookup
RevealSolution --> CourseLookup
FinishSession --> CourseLookup
CourseLookup --> ContentRepository : content
CourseLookup ..> CourseQuestions
SubmitAttempt --> QuestionChecker : checker
SubmitAttempt --> ProgressRepository : progress
RevealNextHint --> ProgressRepository
RevealSolution --> ProgressRepository
FinishSession --> ProgressRepository
OpenSession ..> OpenedSession
SubmitAttempt ..> AttemptOutcome
ProgressRepository ..> ExerciseProgress
QuestionChecker --> ResponseChecker : one per kind
ResponseChecker <|.. McqResponseChecker
ResponseChecker <|.. SingleAnswerResponseChecker
ResponseChecker <|.. FillAnswerResponseChecker
ResponseChecker <|.. OrderAnswerResponseChecker
ResponseChecker <|.. MatchAnswerResponseChecker
ResponseChecker <|.. SelfGradeResponseChecker
SingleAnswerResponseChecker ..> ExpectationMatcher
FillAnswerResponseChecker ..> ExpectationMatcher
LearnerResponse <|.. ChoicesResponse
LearnerResponse <|.. ValueResponse
LearnerResponse <|.. GapsResponse
LearnerResponse <|.. OrderResponse
LearnerResponse <|.. MatchResponse
LearnerResponse <|.. SelfGradeResponse
ResponseChecker ..> CheckResult
CheckResult *-- CheckedItem : items
CheckResult --> Verdict
@enduml
