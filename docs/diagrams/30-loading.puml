@startuml 30-loading
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 50
hide empty members
hide circle
title boussole-format — reading a subject folder (entry point, load, yaml, diagnostic)

class Validator <<see 31-validation>>
class SubjectInspector <<entry point>> {
  +inspect(Path) : InspectionReport
}
class InspectionReport <<record>> {
  course : Optional<Course>
  diagnostics : List<Diagnostic>
  +hasErrors() : boolean
  +errors() / warnings()
  +withCode(DiagnosticCode)
}

package "load" {
  class CourseLoader {
    +{static} load(Path, DiagnosticCollector) : Optional<Course>
  }
  class SubjectFolderFiles {
    ~exists(name) / read(name)
  }
  class CourseSubjectReader
  class CourseSyllabusReader
  class CourseLexiconReader
  class LearnerProfileReader
  class SessionFileReader
  class SourceReferenceReader
}

package "yaml" {
  class YamlMap {
    +{static} parse(text, YamlSource) : Optional<YamlMap>
    +{static} parseList(text, YamlSource) : List<YamlMap>
    +text / requiredText / integer / flag
    +texts / maps / positionOf
    +reportUnknownKeys(Set<String>)
  }
  class "YamlMap.YamlSource" as YamlSource <<record>> {
    fileName : String
    firstLine : int
  }
}

package "diagnostic" {
  class DiagnosticCollector {
    +report(DiagnosticCode, SourcePosition, String)
    +list() : List<Diagnostic>
  }
  class Diagnostic <<record>> {
    message : String
    +isError() : boolean
  }
  enum DiagnosticCode {
    F001 … F032
    P001 … P009
    +severity() : DiagnosticSeverity
  }
  enum DiagnosticSeverity {
    ERROR
    WARNING
  }
  class SourcePosition <<record>> {
    file : String
    line : int
  }
}

SubjectInspector --> CourseLoader : 1. read
SubjectInspector ..> InspectionReport : returns
CourseLoader --> SubjectFolderFiles : files
CourseLoader --> CourseSubjectReader : subject.yaml
CourseLoader --> CourseSyllabusReader : syllabus.yaml
CourseLoader --> CourseLexiconReader : lexique.yaml
CourseLoader --> LearnerProfileReader : learner.yaml
CourseLoader --> SessionFileReader : each session file
CourseSyllabusReader --> SourceReferenceReader
SessionFileReader --> SourceReferenceReader
CourseSubjectReader --> YamlMap
CourseSyllabusReader --> YamlMap
CourseLexiconReader --> YamlMap
LearnerProfileReader --> YamlMap
SessionFileReader --> YamlMap : front matter
YamlMap --> YamlSource


DiagnosticCollector *-- "*" Diagnostic
Diagnostic --> DiagnosticCode
Diagnostic --> SourcePosition
DiagnosticCode --> DiagnosticSeverity
CourseLoader ..> DiagnosticCollector : reports


SubjectInspector --> Validator : 2. check
@enduml
