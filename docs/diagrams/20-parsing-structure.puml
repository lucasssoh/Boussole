@startuml 20-parsing-structure
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 50
hide empty members
hide circle
title boussole-format — reading a session file: structure and directives (load, parse, parse.directive)

class SessionFileReader <<load>> {
  +{static} read(text, file, DiagnosticCollector) : SessionContent
}
class SessionBodyParser {
  +{static} parse(lines, firstLine, file, DiagnosticCollector) : List<Part>
}

package "parse" {
  class ParseContext {
    +position(int) : SourcePosition
    +report(DiagnosticCode, int, String)
    +blocks(List<RawNode>, parent) : List<Block>
    +attributes(directive, source, required, optional, line) : Optional<DirectiveAttributes>
    +answerParsers() : AnswerParserRegistry
  }
  class RawTreeBuilder {
    ~build(lines, firstLine) : List<RawNode>
  }
  class CodeFence {
    ~isCode(String) : boolean
  }
  class DirectiveLine <<record>> {
    name, label, attributes : String
    colons : int
  }
  interface RawNode <<sealed>>
  class "RawNode.Text" as RText <<record>>
  class "RawNode.Heading" as RHeading <<record>>
  class "RawNode.Leaf" as RLeaf <<record>>
  class "RawNode.Container" as RContainer <<record>>
  class PartAssembler {
    ~assemble(List<RawNode>) : List<Part>
  }
  class BlockBuilder {
    ~build(List<RawNode>, parent) : List<Block>
  }
  class InlineDirectiveScanner {
    ~prose(RawNode.Text) : ProseBlock
  }
  class DirectiveAttributeParser {
    ~{static} parse(String) : DirectiveAttributes
  }
  class DirectiveAttributes <<record>> {
    +text(name) / required(name)
    +positiveInteger(name) / flag(name)
  }
  class InvalidAttributeException
}

package "parse.directive" {
  class DirectiveParserRegistry {
    +{static} standard() : DirectiveParserRegistry
    +find(name) : Optional<DirectiveParser>
  }
  interface DirectiveParser <<strategy>> {
    +spec() : DirectiveSpec
    +parse(CheckedDirective, ParseContext) : Optional<Block>
  }
  class DirectiveSpec <<record>> {
    name : String
    required, optional, parents : Set<String>
  }
  enum DirectiveKind {
    CONTAINER
    LEAF
  }
  class CheckedDirective <<record>>
  class DirectivePlaces <<constants>>
  class ExampleDirectiveParser
  class RecallDirectiveParser
  class CalloutDirectiveParser
  class VideoDirectiveParser
  class PdfDirectiveParser
  class RefDirectiveParser
  class ExerciseDirectiveParser
  class McqDirectiveParser
  class ExerciseParts <<record>>
  class McqChoiceReader
}

class AnswerParserRegistry <<see 21-parsing-answers>>

SessionFileReader --> SessionBodyParser : body
SessionBodyParser --> RawTreeBuilder : 1. lines to tree
SessionBodyParser --> PartAssembler : 2. tree to parts
RawTreeBuilder --> CodeFence
RawTreeBuilder --> DirectiveLine
RawTreeBuilder ..> RawNode : builds
RawNode <|.. RText
RawNode <|.. RHeading
RawNode <|.. RLeaf
RawNode <|.. RContainer
PartAssembler --> ParseContext
ParseContext *-- BlockBuilder
ParseContext *-- AnswerParserRegistry
BlockBuilder --> DirectiveParserRegistry
BlockBuilder --> InlineDirectiveScanner
ParseContext ..> DirectiveAttributeParser
DirectiveAttributeParser ..> DirectiveAttributes
DirectiveAttributes ..> InvalidAttributeException : throws

DirectiveParserRegistry o-- "*" DirectiveParser
DirectiveParser --> DirectiveSpec
DirectiveSpec --> DirectiveKind
DirectiveParser ..> CheckedDirective
DirectiveParser <|.. ExampleDirectiveParser
DirectiveParser <|.. RecallDirectiveParser
DirectiveParser <|.. CalloutDirectiveParser
DirectiveParser <|.. VideoDirectiveParser
DirectiveParser <|.. PdfDirectiveParser
DirectiveParser <|.. RefDirectiveParser
DirectiveParser <|.. ExerciseDirectiveParser
DirectiveParser <|.. McqDirectiveParser
ExerciseDirectiveParser --> ExerciseParts
McqDirectiveParser --> ExerciseParts
McqDirectiveParser --> McqChoiceReader
ExerciseDirectiveParser --> AnswerParserRegistry : answer by type

@enduml
