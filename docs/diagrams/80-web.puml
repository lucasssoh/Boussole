@startuml 80-web
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 50
hide empty members
hide circle
title web/ — the Angular interface

package "core" {
  class BoussoleApi <<service>>
  class boussoleHeaderInterceptor <<interceptor>>
  class LanguageService <<service>>
  class ThemeService <<service>>
  class SettingsDrawerComponent <<gear: a panel pulled down, theme and language>>
  class StatsService <<service>> {
    stats : Signal
  }
  class ServerSettingsService <<service>> {
    freeNavigation : Signal
  }
  class "api.ts" as Api <<types of the HTTP API>>
}

package "learn" {
  class LearnFacade <<facade>> {
    subjects, course, session, panel : Signal
  }
  class SessionRun <<per session page>> {
    spentSeconds, remainingSeconds : Signal
    seen, verdicts : Signal
    +question(id, create) : QuestionState
    +record(question, verdict)
  }
  class SubjectListComponent <<page />>
  class CoursePageComponent <<page subjects/:subject>>
  class SessionPageComponent <<page …/sessions/:session?screen=N>> {
    index, screen : Signal
    +goTo(index)
  }
  class "sessionPlan()" as SessionPlan <<start, explanation, example, question…, end>>
  class SessionPathComponent <<the session as a path of nodes>>
  class SessionGridComponent <<the sessions as a grid, by chapter>>
  class SidePanelComponent <<video, PDF or web page>>
}

package "learn.blocks" {
  class BlockListComponent <<@switch on block.type>>
  class ProseBlockComponent
  class VideoBlockComponent
  class PdfBlockComponent
  class GraphBlockComponent
  class LinkBlockComponent
  class WebReferences <<service>> {
    +preview(url) : Promise<PagePreview>
    +open(label, url)
    +openWindow(url) : boolean
  }
  class GraphDrawing <<drawGraph()>>
}

package "learn.question" {
  class McqBlockComponent
  class ExerciseBlockComponent
  class QuestionFooterComponent <<hints, then one answer>>
  class QuestionCorrectionComponent <<why, beside the question>>
  class QuestionHeaderComponent
  class QuestionState {
    progress, result, hints, solution : Signal
    picked, value, order, pairs, gaps : Signal
    +attempt(AttemptRequest)
    +nextHint()
    +showSolution() : free exercise
    answered, correctionShown : Signal
  }
  class FillGaps <<fields in the statement>>
}

package "shared" {
  class MarkdownRenderer <<markdown-it + KaTeX>>
  class "subjectColor()" as SubjectColor
  class RichTextComponent
  class "drawMermaidDiagrams()" as Mermaid
  class IconComponent <<SVG icons, no emoji>> {
    +iconSvg(name) : string
  }
}

SubjectListComponent --> LearnFacade
QuestionFooterComponent ..> IconComponent : hint, arrows
FillGaps ..> IconComponent : iconSvg()
CoursePageComponent --> LearnFacade
SessionPageComponent --> LearnFacade
SessionPageComponent *-- SessionRun : provides
SessionPageComponent ..> SessionPlan : screens
SessionPageComponent ..> ServerSettingsService : free navigation?
SessionPageComponent --> SessionPathComponent
QuestionState ..> StatsService : refresh after an answer
SessionPageComponent --> BlockListComponent : the screen shown
SessionRun o-- QuestionState : kept for the sitting
SessionPageComponent --> SidePanelComponent
LearnFacade --> BoussoleApi
BlockListComponent --> ProseBlockComponent
BlockListComponent --> VideoBlockComponent
BlockListComponent --> PdfBlockComponent
BlockListComponent --> GraphBlockComponent
BlockListComponent --> LinkBlockComponent
SidePanelComponent ..> WebReferences : preview, window
LinkBlockComponent ..> WebReferences : looks ahead, opens
ProseBlockComponent ..> WebReferences : :link
WebReferences ..> BoussoleApi : previewPage()
GraphBlockComponent ..> GraphDrawing : pixels
BlockListComponent --> McqBlockComponent
BlockListComponent --> ExerciseBlockComponent
McqBlockComponent *-- QuestionState
ExerciseBlockComponent *-- QuestionState
ExerciseBlockComponent *-- FillGaps
McqBlockComponent --> QuestionFooterComponent
ExerciseBlockComponent --> QuestionFooterComponent
McqBlockComponent --> QuestionCorrectionComponent
ExerciseBlockComponent --> QuestionCorrectionComponent
QuestionState --> BoussoleApi
QuestionState ..> SessionRun : first verdicts
ProseBlockComponent --> MarkdownRenderer
ProseBlockComponent ..> FillGaps : mounts fields
ProseBlockComponent ..> Mermaid
VideoBlockComponent ..> LearnFacade : opens panel
PdfBlockComponent ..> LearnFacade : opens panel
@enduml
