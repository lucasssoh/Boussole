@startuml 80-web
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 50
hide empty members
hide circle
title web/ — the Angular interface

package "core" {
  class BoussoleApi <<service>>
  class boussoleHeaderInterceptor <<interceptor>>
  class LanguageService <<service>>
  class SettingsDrawerComponent <<gear: a panel pulled down, the language>>
  class StatsService <<service>> {
    stats : Signal
  }
  class ServerSettingsService <<service>> {
    freeNavigation : Signal
  }
  class "api.ts" as Api <<types of the HTTP API>>
}

package "progress" {
  class ProfilePageComponent <<page profile>>
  class RanksPageComponent <<page ranks: the tiers of the culture on one line, the learner's larger>>
  class RankNames <<service: ranks, fields, points>>
  note right of ProfilePageComponent : the card, the route, the specialties,\nthe achievements in frames waiting for their icons
}

package "learn" {
  class LearnFacade <<facade>> {
    subjects, course, session, panel : Signal
    +trackLanguage(subject) : string
    +chooseTrackLanguage(subject, language)
  }
  class SessionRun <<per session page>> {
    spentSeconds, remainingSeconds : Signal
    seen, verdicts, stars, lastAnswered : Signal
    +question(id, create) : QuestionState
    +record(question, verdict, points, stars)
  }
  class SubjectListComponent <<page />>
  class CoursePageComponent <<page subjects/:subject>>
  class SessionPageComponent <<page …/sessions/:session?screen=N>> {
    index, screen : Signal
    +goTo(index)
  }
  class "sessionPlan()" as SessionPlan <<start, explanation, example, question…, end>>
  class SessionPathComponent <<the session as a path of nodes, stars on a plate under answered ones>>
  class StarsComponent <<3 stars in relief: gold, blue (met before), outlined (own estimate); arrive one by one>>
  class "starTone(), starSummary()" as StarRules <<gold counts, blue and outlined do not, hooks have none>>
  class SessionGridComponent <<the sessions of a chapter as a grid, on the home page>>
  class LoadingComponent <<the needle turning while a page waits>>
  class CourseMapComponent <<the map of a track: chapters, then a chapter zoomed into its sessions>>
  class "graph-layout.ts" as GraphLayout <<floors no wider than the map, order without crossings, links routed>>
  class "chapterColor()" as ChapterColor <<the colour of a chapter, by its place>>
  class TrackLanguagesComponent <<the languages of a track, chips>>
  class SidePanelComponent <<video, PDF, Markdown or web page, or the documents of the session>>
  class MarkdownDocumentComponent <<a cited Markdown document, rendered beside the lesson>>
  class "sessionDocuments()" as SessionDocuments <<what the session cites, by document and page>>
}

package "learn.blocks" {
  class BlockListComponent <<@switch on block.type>>
  class ProseBlockComponent
  class VideoBlockComponent
  class PdfBlockComponent
  class GraphBlockComponent
  class LinkBlockComponent
  class WebReferences <<service>> {
    +preview(url) : Promise<PagePreview>
    +open(label, url)
    +openWindow(url) : boolean
  }
  class GraphDrawing <<drawGraph()>>
}

package "learn.question" {
  class McqBlockComponent
  class ExerciseBlockComponent
  class QuestionFooterComponent <<hints, then one answer>>
  class QuestionCorrectionComponent <<why, beside the question>>
  class QuestionHeaderComponent
  class QuestionState {
    progress, result, hints, solution : Signal
    picked, value, order, pairs, gaps : Signal
    +attempt(AttemptRequest)
    +nextHint()
    +showSolution() : free exercise
    answered, correctionShown : Signal
    stars, starTone, fresh
  }
  class FillGaps <<fields in the statement>>
}

package "shared" {
  class MarkdownRenderer <<markdown-it + KaTeX>>
  class "subjectColor()" as SubjectColor
  class RankEmblemComponent <<the gem of a rank, its division in relief>>
  class "emblem.ts" as Emblem <<instruments, ornaments, aura per tier; pieces that come apart>>
  class SpecialtyEmblemComponent <<the medallion of a specialty>>
  class RankPillComponent <<emblem, level, points / next mark; the body fills as a gauge; +N rises on a gain>>
  class "pill-frame.ts" as PillFrame <<a frame per tier, culture and specialty>>
  class RankRouteComponent <<every division as its emblem, the learner's in the middle>>
  class PromotionComponent <<after a session: the emblem over a veil, put together again>>
  class "ranks.ts" as Ranks <<tier colours, roman divisions, points>>
  class RichTextComponent
  class ChoiceMenuComponent <<a drop-down list drawn by the interface, not by the browser>>
  class "drawMermaidDiagrams()" as Mermaid
  class IconComponent <<SVG icons, no emoji>> {
    +iconSvg(name) : string
  }
}

SubjectListComponent --> LearnFacade
CoursePageComponent --> TrackLanguagesComponent : follow in
SessionPageComponent --> TrackLanguagesComponent : switch, same place
QuestionFooterComponent ..> IconComponent : hint, arrows
FillGaps ..> IconComponent : iconSvg()
FillGaps ..> ChoiceMenuComponent : a choice gap
ExerciseBlockComponent --> ChoiceMenuComponent : pairs
CoursePageComponent --> LearnFacade
CoursePageComponent --> CourseMapComponent : the map
CourseMapComponent ..> GraphLayout
CourseMapComponent ..> ChapterColor
SessionPageComponent --> LearnFacade
SessionPageComponent *-- SessionRun : provides
SessionPageComponent ..> SessionPlan : screens
SessionPageComponent ..> ServerSettingsService : free navigation?
SessionPageComponent --> SessionPathComponent
SessionPageComponent --> StarsComponent : wrap-up
SessionPageComponent ..> StarRules : total, each part
SessionPathComponent --> StarsComponent
SessionGridComponent --> StarsComponent : stars of each session
QuestionCorrectionComponent --> StarsComponent
QuestionState ..> StarRules : tone
QuestionState ..> StatsService : refresh after an answer
RankEmblemComponent ..> Emblem : look and geometry
RankEmblemComponent ..> Ranks : roman divisions
PromotionComponent --> RankEmblemComponent : leave, assemble, renumber
PromotionComponent --> RankPillComponent : the new pill
RankPillComponent --> RankEmblemComponent
RankPillComponent --> SpecialtyEmblemComponent
RankPillComponent ..> PillFrame
PillFrame ..> Emblem : colours
StatsService ..> PromotionComponent : a division newly reached, held while studying
SessionPageComponent ..> StatsService : studying
ProfilePageComponent ..> StatsService : stats
ProfilePageComponent ..> RankEmblemComponent
ProfilePageComponent --> RankRouteComponent : the route of the culture
RankRouteComponent ..> RankEmblemComponent
ProfilePageComponent --> RankPillComponent : each specialty
RanksPageComponent ..> BoussoleApi : ranks
ProfilePageComponent ..> RankNames
RanksPageComponent ..> RankNames
SessionPageComponent --> BlockListComponent : the screen shown
SessionRun o-- QuestionState : kept for the sitting
SessionPageComponent --> SidePanelComponent : documents, screen
SessionPageComponent ..> SessionDocuments
SessionDocuments ..> SessionPlan
LearnFacade --> BoussoleApi
BlockListComponent --> ProseBlockComponent
BlockListComponent --> VideoBlockComponent
BlockListComponent --> PdfBlockComponent
BlockListComponent --> GraphBlockComponent
BlockListComponent --> LinkBlockComponent
SidePanelComponent ..> WebReferences : preview, window
SidePanelComponent --> MarkdownDocumentComponent : cited Markdown file
MarkdownDocumentComponent --> ProseBlockComponent : renders source
LinkBlockComponent ..> WebReferences : looks ahead, opens
ProseBlockComponent ..> WebReferences : :link
WebReferences ..> BoussoleApi : previewPage()
GraphBlockComponent ..> GraphDrawing : pixels
BlockListComponent --> McqBlockComponent
BlockListComponent --> ExerciseBlockComponent
McqBlockComponent *-- QuestionState
ExerciseBlockComponent *-- QuestionState
ExerciseBlockComponent *-- FillGaps
McqBlockComponent --> QuestionFooterComponent
ExerciseBlockComponent --> QuestionFooterComponent
McqBlockComponent --> QuestionCorrectionComponent
ExerciseBlockComponent --> QuestionCorrectionComponent
QuestionState --> BoussoleApi
QuestionState ..> SessionRun : first verdicts
ProseBlockComponent --> MarkdownRenderer
ProseBlockComponent ..> FillGaps : mounts fields
ProseBlockComponent ..> Mermaid
VideoBlockComponent ..> LearnFacade : opens panel
PdfBlockComponent ..> LearnFacade : opens panel
@enduml
