@startuml 10-model-course
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 50
hide empty members
hide circle
title boussole-format — the course model (package model, model.part)

class Course <<record>> {
  root : Path
  learner : Optional<LearnerProfile>
  sources : Optional<CourseSources>
  +blocks() : Stream<Block>
  +sessionId(SyllabusChapter, SyllabusSession) : SessionId
}
class CourseSubject <<record>> {
  id, name, lang : String
  sourcesDir : String
  description : Optional<String>
  level : Optional<TrackLevel>
  domain : Optional<Domain>
}
enum TrackLevel {
  DISCOVERY
  SECONDARY
  BACHELOR
  MASTER
  RESEARCH
  +coefficient() : double
}
enum Domain {
  INFORMATION_TECHNOLOGY
  MATHEMATICS
  PHILOSOPHY_AND_ETHICS
  …
  +isced() : String
}
class CourseSyllabus <<record>>
enum SyllabusStatus {
  PROPOSED
  APPROVED
}
class SyllabusChapter <<record>> {
  id, title, dir : String
  sources : List<SourceReference>
}
class SyllabusSession <<record>> {
  id, title, goal, file : String
  duration : int
}
enum SessionKind {
  LESSON
  REVIEW
  EXAM
  +isTimed() : boolean
  +minDuration() / maxDuration() : int
}
class SessionId <<record>> {
  subject, chapter, session : String
}
class CourseLexicon <<record>> {
  +byId(String) : Optional<LexiconTerm>
  +byName(String) : Optional<LexiconTerm>
}
class LexiconTerm <<record>> {
  id, term, definition : String
  aliases, see : List<String>
}
class CourseSources <<record>>
class SourceEntry <<record>> {
  file : String
  sha256 : Optional<String>
  chapters : List<String>
  note : String
  +isPattern() : boolean
}
class Authorship <<record>> {
  model, tool, name : Optional<String>
  date : Optional<LocalDate>
  +who() : String
}
enum AuthorshipRole {
  WROTE
  REVISED
  TRANSLATED
}
class SubjectCredit <<record>> {
  name : String
  organisation : boolean
  role, url : Optional<String>
}
class SourceProvenance <<record>> {
  url, title, licence : Optional<String>
  retrieved : Optional<LocalDate>
}
enum SourceStatus {
  USED
  IGNORED
  PENDING
}
class LearnerProfile <<record>> {
  background, notes : String
  sessionMinutes : int
  quickCheck : boolean
}
note bottom of LearnerProfile
  enums: Goal, Explanations,
  Order, Closing, Videos
end note
class CourseSession <<record>> {
  file : String
}
class SessionContent <<record>> {
  +blocks() : Stream<Block>
}
class SessionFrontMatter <<record>> {
  id : String
  objectives, prerequisites, terms : List<String>
}
class SourceReference <<record>> {
  file : String
  page : OptionalInt
}

interface Part <<sealed>> {
  +blocks() : List<Block>
  +position() : SourcePosition
}
class TextPart <<record>>
class WarmupPart <<record>>
class NotionPart <<record>> {
  id, title : String
}
class CheckpointPart <<record>>
class PracticePart <<record>>

Course *-- "1" CourseSubject : subject
CourseSubject --> TrackLevel : level
CourseSubject --> Domain : domain
Course *-- "1" CourseSyllabus : syllabus
Course *-- "1" CourseLexicon : lexicon
Course *-- "0..1" LearnerProfile : learner
Course *-- "0..1" CourseSources : sources
CourseSources *-- "*" SourceEntry : entries
SourceEntry --> SourceStatus : status
SourceEntry *-- SourceProvenance : provenance
Course *-- "*" CourseSession : sessions read
CourseSyllabus *-- "*" SyllabusChapter : chapters
CourseSyllabus --> SyllabusStatus : status
SyllabusChapter *-- "*" SyllabusSession : sessions
SyllabusSession --> SessionKind : kind
CourseLexicon *-- "*" LexiconTerm : terms
CourseSession --> SessionId : id
CourseSession --> SyllabusChapter : chapter
CourseSession --> SyllabusSession : entry
CourseSession *-- "1" SessionContent : session
SessionContent *-- "1" SessionFrontMatter : header
SessionContent *-- "*" Part : parts
SessionFrontMatter *-- "*" SourceReference : sources
Part <|.. TextPart
Part <|.. WarmupPart
Part <|.. NotionPart
Part <|.. CheckpointPart
Part <|.. PracticePart
Part o-- "*" Block : blocks

class Block <<sealed interface>>
note bottom of Block : see 11-model-blocks
CourseSubject *-- "*" SubjectCredit : authors, contributors
SessionFrontMatter *-- "*" Authorship : writtenBy
Authorship --> AuthorshipRole : role

@enduml
