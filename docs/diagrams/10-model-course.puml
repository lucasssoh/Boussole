@startuml 10-model-course
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 50
hide empty members
hide circle
title boussole-format — the course model (package model, model.part)

class Course <<record>> {
  root : Path
  learner : Optional<LearnerProfile>
  +blocks() : Stream<Block>
  +sessionId(Chapter, SessionEntry) : SessionId
}
class Subject <<record>> {
  id, name, lang : String
  sourcesDir : String
  description : Optional<String>
}
class Syllabus <<record>>
enum SyllabusStatus {
  PROPOSED
  APPROVED
}
class Chapter <<record>> {
  id, title, dir : String
  sources : List<SourceRef>
}
class SessionEntry <<record>> {
  id, title, goal, file : String
  duration : int
}
enum SessionKind {
  LESSON
  REVIEW
  EXAM
  +isTimed() : boolean
  +minDuration() / maxDuration() : int
}
class SessionId <<record>> {
  subject, chapter, session : String
}
class Lexicon <<record>> {
  +byId(String) : Optional<Term>
  +byName(String) : Optional<Term>
}
class Term <<record>> {
  id, term, definition : String
  aliases, see : List<String>
}
class LearnerProfile <<record>> {
  background, notes : String
  sessionMinutes : int
  quickCheck : boolean
}
note bottom of LearnerProfile
  enums: Goal, Explanations,
  Order, Closing, Videos
end note
class LoadedSession <<record>> {
  file : String
}
class Session <<record>> {
  +blocks() : Stream<Block>
}
class SessionHeader <<record>> {
  id : String
  objectives, prerequisites, terms : List<String>
}
class SourceRef <<record>> {
  file : String
  page : OptionalInt
}

interface Part <<sealed>> {
  +blocks() : List<Block>
  +position() : Position
}
class TextPart <<record>>
class Warmup <<record>>
class Notion <<record>> {
  id, title : String
}
class Checkpoint <<record>>
class Practice <<record>>

Course *-- "1" Subject : subject
Course *-- "1" Syllabus : syllabus
Course *-- "1" Lexicon : lexicon
Course *-- "0..1" LearnerProfile : learner
Course *-- "*" LoadedSession : sessions read
Syllabus *-- "*" Chapter : chapters
Syllabus --> SyllabusStatus : status
Chapter *-- "*" SessionEntry : sessions
SessionEntry --> SessionKind : kind
Lexicon *-- "*" Term : terms
LoadedSession --> SessionId : id
LoadedSession --> Chapter : chapter
LoadedSession --> SessionEntry : entry
LoadedSession *-- "1" Session : session
Session *-- "1" SessionHeader : header
Session *-- "*" Part : parts
SessionHeader *-- "*" SourceRef : sources
Part <|.. TextPart
Part <|.. Warmup
Part <|.. Notion
Part <|.. Checkpoint
Part <|.. Practice
Part o-- "*" Block : blocks

class Block <<sealed interface>>
note bottom of Block : see 11-model-blocks
@enduml
