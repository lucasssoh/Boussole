@startuml 40-cli
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 50
hide empty members
hide circle
title boussole-cli — the boussole command (packages cli, cli.init, cli.serve, cli.devices)

package "cli" {
  class BoussoleCommand <<@Command boussole>> {
    +{static} main(String[])
  }
  class SourcesCommand <<@Command sources>> {
    folder : Path
    all : boolean
  }
  class IndexCommand <<@Command index>> {
    folder : Path
    before : String
  }
  class TrackVersionFolders <<siblings, config.yaml>> {
    +{static} of(folder, id, subjects) : List<Path>
  }
  class ValidateCommand <<@Command validate>> {
    folder : Path
    errorsOnly : boolean
    checkVideos : boolean
    +call() : Integer
  }
  class ReportPrinter {
    ~print(InspectionReport)
  }
  class ExitCode <<constants>> {
    OK = 0
    PROBLEMS = 1
    UNUSABLE = 2
  }
  class ManifestVersion <<IVersionProvider>>
  class Launcher <<record>> {
    app : Optional<Path> <<packaged program>>
    jar : Optional<Path>
    +{static} current() : Launcher
    +validateCommand() : String
    +{static} commandLine(Path jar, String...) : List<String>
  }
}

package "cli.serve" {
  class OpenCommand <<@Command open>> {
    folder : Path
    resume : boolean
    +call() : Integer
  }
  class ServeCommand <<@Command serve>> {
    port : Integer
    +call() : Integer
  }
  class StopCommand <<@Command stop>> {
    +call() : Integer
  }
  class ServerProbe {
    ~url(String) : String
    ~sessionToResume(String) : Optional<String>
    ~isBoussole() : boolean
    ~portTaken() : boolean
    ~waitUntilUp(Duration) : boolean
    ~stop()
  }
  class BackgroundServer {
    ~{static} start(BoussolePaths) : Optional<Process>
  }
  class ServerPidFile {
    ~writeCurrent()
    ~server() : Optional<ProcessHandle>
  }
  class BrowserOpener {
    ~{static} open(String url) : boolean
  }
}

package "cli.devices" {
  class DevicesCommand <<@Command devices>> {
    network, requests, devices
  }
  class PairCommand <<@Command pair>> {
    --read-only
  }
  class AcceptCommand <<@Command accept>> {
    CODE --read-only
  }
  class DenyCommand <<@Command deny>> {
    CODE
  }
  class RemoveDeviceCommand <<@Command remove>> {
    DEVICE
  }
  class RenameDeviceCommand <<@Command rename>> {
    DEVICE NAME
  }
  class AccessCommand <<@Command access>> {
    DEVICE full|read-only
  }
  class LocalServer <<the API on 127.0.0.1>>
  class QrText <<half blocks, black on white>>
  class Devices <<helpers>>
  class DeviceCommandException
}

package "cli.init" {
  class InitCommand <<@Command init>> {
    folder : Path
    id, name, lang, sources : String
    profile : Path
    +call() : Integer
  }
  class NewCommand <<@Command new>> {
    name, goal, lang : String
    in : Path
    +call() : Integer
  }
  class SubjectScaffold
  class AgentKitInstaller
  class AgentKit <<resources>>
  class MarkedBlock
  class SubjectFolder
  class InitReport
  class Slug
  class LearnerProfiles {
    ~{static} usual() : Path
  }
}

class SubjectInspector <<boussole-format>>
class YoutubeOEmbedCatalog <<boussole-adapters>>
class BoussoleConfigFile <<boussole-adapters>>
class BoussolePaths <<boussole-adapters>>
class BoussoleServer <<boussole-server>>
class LocalCertificate <<boussole-adapters>>
class NetworkAddresses <<boussole-adapters>>

BoussoleCommand --> OpenCommand : subcommand
BoussoleCommand --> ServeCommand : subcommand
BoussoleCommand --> StopCommand : subcommand
BoussoleCommand --> InitCommand : subcommand
BoussoleCommand --> NewCommand : subcommand
NewCommand --> SubjectScaffold : folder, subject files, goal
NewCommand --> AgentKitInstaller : agent kit
NewCommand ..> BoussoleConfigFile : tracks_dir, adds the track
BoussoleCommand --> ValidateCommand : subcommand
BoussoleCommand --> SourcesCommand : subcommand
BoussoleCommand --> IndexCommand : subcommand
BoussoleCommand --> DevicesCommand : subcommand
DevicesCommand --> PairCommand
DevicesCommand --> AcceptCommand
DevicesCommand --> DenyCommand
DevicesCommand --> RemoveDeviceCommand
DevicesCommand --> RenameDeviceCommand
DevicesCommand --> AccessCommand
DevicesCommand --> LocalServer : /api/devices
PairCommand --> QrText : the address with its code
PairCommand ..> Devices
ServeCommand ..> NetworkAddresses : network: true
ServeCommand ..> LocalCertificate : makes or keeps it
BoussoleCommand --> ManifestVersion
ValidateCommand --> SubjectInspector : inspects
ValidateCommand ..> YoutubeOEmbedCatalog : --check-videos
ValidateCommand --> ReportPrinter : prints
ValidateCommand ..> ExitCode
OpenCommand --> BoussoleConfigFile : adds the subject
OpenCommand --> ServerProbe : running?
OpenCommand --> BackgroundServer : else starts
OpenCommand --> BrowserOpener
BackgroundServer --> Launcher : the packaged program, or a copy of the jar, serve
ServeCommand --> ServerPidFile : writes
StopCommand --> ServerPidFile : unanswered server
StopCommand --> ServerProbe
ServeCommand --> BoussoleServer : starts
ServeCommand --> BoussoleConfigFile
ServeCommand ..> BoussolePaths : state.db
InitCommand --> SubjectScaffold : 1. subject files
InitCommand --> AgentKitInstaller : 2. agent kit
InitCommand --> Launcher : validate command
InitCommand ..> LearnerProfiles : usual profile
LearnerProfiles ..> BoussolePaths
SubjectScaffold --> SubjectFolder
SubjectScaffold ..> Slug
AgentKitInstaller --> SubjectFolder
AgentKitInstaller --> AgentKit : skills, format
AgentKitInstaller --> MarkedBlock : AGENTS.md
SubjectScaffold ..> InitReport
AgentKitInstaller ..> InitReport
ValidateCommand ..> TrackVersionFolders : other versions

@enduml
